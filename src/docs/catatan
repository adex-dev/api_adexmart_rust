// Query update
pub async fn logout_token(
    db: &Pool<Postgres>,
    jti: &str,
) -> Result<(), AppError> {
    let jti = parse_jti(jti)?;
   let result_update = sqlx::query!(
        r#"
        UPDATE refresh_tokens SET revoked=TRUE WHERE jti = COALESCE($1,jti)"#,jti
    ).execute(db)
        .await
        .map_err(|e| AppError::Validation(e.to_string()))?;
    match result_update{
        Ok(
            if result_update.row_affected() > 0 {
                return Ok
            }
        )
    }
}

